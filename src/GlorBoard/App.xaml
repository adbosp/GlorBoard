<Application x:Class="GlorBoard.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:GlorBoard"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <CornerRadius x:Key="GlassCornerRadius">6</CornerRadius>
        <Style x:Key="GlassWindowSurface" TargetType="ContentControl">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContentControl">
                        <Grid>
                            <local:RefractiveBackdrop FallbackFill="{DynamicResource GlassStandbyFill}"/>
                            <ContentPresenter Margin="1"/>
                            <Border Margin="2" BorderBrush="{DynamicResource GlassRim}" BorderThickness="1.25"
                                    CornerRadius="{DynamicResource GlassCornerRadius}" IsHitTestVisible="False"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource SecondaryText}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Medium"/>
        </Style>
        <Style x:Key="GlassCard" TargetType="Border">
            <Setter Property="local:RefractiveBackdrop.IsRegion" Value="True"/>
            <Setter Property="Background" Value="{DynamicResource GlassReflection}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="26"/>
            <Style.Triggers>
                <Trigger Property="local:RefractiveBackdrop.OpticsEnabled" Value="True">
                    <Setter Property="Background" Value="{DynamicResource ClearCardFill}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="GlassDock" TargetType="Border" BasedOn="{StaticResource GlassCard}">
            <Setter Property="Background" Value="{DynamicResource GlassDockFill}"/>
            <Setter Property="CornerRadius" Value="20"/>
            <Style.Triggers>
                <Trigger Property="local:RefractiveBackdrop.OpticsEnabled" Value="True">
                    <Setter Property="Background" Value="{DynamicResource ClearDockFill}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="GlassButton" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource Text}"/>
            <Setter Property="Background" Value="{DynamicResource ControlFill}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource GlassLine}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" CornerRadius="22" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                            <Grid>
                                <Border x:Name="Hover" CornerRadius="22" Background="{DynamicResource HoverWash}"
                                        Opacity="0" IsHitTestVisible="False"/>
                                <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"
                                                  Margin="{TemplateBinding Padding}" RecognizesAccessKey="True"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource FocusLine}"/>
                            </Trigger>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource TemplatedParent}}" Value="True"/>
                                    <Condition Binding="{Binding Source={x:Static SystemParameters.ClientAreaAnimation}}" Value="True"/>
                                </MultiDataTrigger.Conditions>
                                <MultiDataTrigger.EnterActions>
                                    <BeginStoryboard><Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To=".5" Duration="0:0:0.14"/>
                                    </Storyboard></BeginStoryboard>
                                </MultiDataTrigger.EnterActions>
                                <MultiDataTrigger.ExitActions>
                                    <BeginStoryboard><Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.16"/>
                                    </Storyboard></BeginStoryboard>
                                </MultiDataTrigger.ExitActions>
                            </MultiDataTrigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource FocusLine}"/>
                                <Setter TargetName="Surface" Property="BorderThickness" Value="2"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Opacity" Value=".8"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value=".45"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Button" BasedOn="{StaticResource GlassButton}"/>
        <Style x:Key="AppearanceButtonStyle" TargetType="Button" BasedOn="{StaticResource GlassButton}">
            <Setter Property="Width" Value="78"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="5,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Background" Value="{DynamicResource AppearanceFill}"/>
            <Setter Property="Foreground" Value="{DynamicResource MenuText}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppearanceBorder}"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonSurface" CornerRadius="12" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center"
                                              VerticalAlignment="Center" RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonSurface" Property="BorderBrush" Value="{DynamicResource FocusLine}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="ButtonSurface" Property="BorderBrush" Value="{DynamicResource FocusLine}"/>
                                <Setter TargetName="ButtonSurface" Property="BorderThickness" Value="2"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonSurface" Property="Opacity" Value=".86"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="GlassIconButton" TargetType="Button" BasedOn="{StaticResource GlassButton}">
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="ContentTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <Grid Width="16" Height="16">
                            <Path Data="{Binding}" Stretch="None" StrokeThickness="1.55"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                        </Grid>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource GlassButton}">
            <Setter Property="Background" Value="{DynamicResource ActionFill}"/>
            <Setter Property="Foreground" Value="{DynamicResource ActionText}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource GlassRim}"/>
        </Style>
        <Style x:Key="ThemeChoice" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource Text}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="3,0"/>
            <Setter Property="MinHeight" Value="42"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Segment" Background="{DynamicResource ControlFill}" BorderBrush="{DynamicResource GlassLine}"
                                BorderThickness="1" CornerRadius="18">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="8,4"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Segment" Property="Background" Value="{DynamicResource SelectionFill}"/>
                                <Setter Property="Foreground" Value="{DynamicResource SelectionText}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Segment" Property="BorderBrush" Value="{DynamicResource FocusLine}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Segment" Property="BorderBrush" Value="{DynamicResource FocusLine}"/>
                                <Setter TargetName="Segment" Property="BorderThickness" Value="2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource MenuText}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="12,9"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Row" Background="Transparent" Padding="{TemplateBinding Padding}" CornerRadius="12">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="{DynamicResource SelectionFill}"/>
                                <Setter Property="Foreground" Value="{DynamicResource SelectionText}"/>
                            </Trigger>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="{DynamicResource SelectionFill}"/>
                                <Setter Property="Foreground" Value="{DynamicResource SelectionText}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="{DynamicResource Text}"/>
            <Setter Property="Background" Value="{DynamicResource ControlFill}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource GlassLine}"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Height" Value="39"/>
            <Setter Property="MaxDropDownHeight" Value="260"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Focusable="False" Foreground="{TemplateBinding Foreground}"
                                          IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" ClickMode="Press">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="Well" Background="{Binding Background, RelativeSource={RelativeSource AncestorType=ComboBox}}" BorderBrush="{DynamicResource GlassLine}" BorderThickness="1" CornerRadius="20">
                                            <Path HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,13,0"
                                                  Data="M 0 0 L 4 4 L 8 0" Stroke="{TemplateBinding Foreground}" StrokeThickness="1.5"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Well" Property="BorderBrush" Value="{DynamicResource FocusLine}"/></Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter Margin="13,0,26,0" VerticalAlignment="Center" IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"/>
                            <Border x:Name="ComboFocus" Visibility="Collapsed" BorderBrush="{DynamicResource FocusLine}"
                                    BorderThickness="2" CornerRadius="20" IsHitTestVisible="False"/>
                            <Popup x:Name="PART_Popup" Placement="Bottom" AllowsTransparency="True"
                                   IsOpen="{TemplateBinding IsDropDownOpen}" Focusable="False"
                                   PopupAnimation="{DynamicResource {x:Static SystemParameters.ComboBoxPopupAnimationKey}}">
                                <Border Background="{DynamicResource MenuFill}" BorderBrush="{DynamicResource GlassRim}" BorderThickness="1" CornerRadius="17" Padding="5" MinWidth="{TemplateBinding ActualWidth}" Margin="0,4,0,2">
                                    <ScrollViewer CanContentScroll="True" MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="ComboFocus" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource Text}"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Margin="0,2" Background="Transparent">
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="35"/></Grid.ColumnDefinitions>
                            <ContentPresenter Margin="0,4,9,4" VerticalAlignment="Center"/>
                            <Border x:Name="Track" Grid.Column="1" Height="19" CornerRadius="10" Background="{DynamicResource InactiveTrack}" BorderBrush="{DynamicResource GlassLine}" BorderThickness="1"/>
                            <Ellipse x:Name="Thumb" Grid.Column="1" Width="13" Height="13" HorizontalAlignment="Left" Margin="3,0,0,0" VerticalAlignment="Center" Fill="{DynamicResource Text}"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{DynamicResource ActiveTrack}"/>
                                <Setter TargetName="Thumb" Property="Fill" Value="{DynamicResource ThumbFill}"/>
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="Thumb" Property="Margin" Value="0,0,3,0"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource FocusLine}"/>
                                <Setter TargetName="Track" Property="BorderThickness" Value="2"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource FocusLine}"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value=".5"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="GlassGrid" TargetType="DataGrid">
            <Setter Property="Background" Value="{DynamicResource FieldFill}"/>
            <Setter Property="RowBackground" Value="{DynamicResource FieldFill}"/>
            <Setter Property="AlternatingRowBackground" Value="{DynamicResource AlternateRow}"/>
            <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource Separator}"/>
            <Setter Property="Foreground" Value="{DynamicResource Text}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="RowHeight" Value="34"/>
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{DynamicResource MenuFill}"/>
            <Setter Property="Foreground" Value="{DynamicResource Text}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Separator}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style TargetType="DataGridCell">
            <Setter Property="Foreground" Value="{DynamicResource Text}"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource SelectionFill}"/>
                    <Setter Property="Foreground" Value="{DynamicResource SelectionText}"/>
                </Trigger>
                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource FocusLine}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="GlassCellText" TargetType="TextBlock">
            <Setter Property="Margin" Value="9,0,6,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
        <Style x:Key="GlassEditor" TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource FieldFill}"/>
            <Setter Property="Foreground" Value="{DynamicResource Text}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource Text}"/>
            <Setter Property="SelectionBrush" Value="{DynamicResource SelectionFill}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource FocusLine}"/>
            <Setter Property="Padding" Value="7,3"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </Application.Resources>
</Application>
